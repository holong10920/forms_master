{
  "schemaVersion": "1.0.0",
  "kind": "form",
  "formId": "frm_gakki_apply_reference",
  "siteId": "site_pc_synthetic",
  "locale": {
    "default": "ja",
    "supported": [
      "ja",
      "vi"
    ]
  },
  "appearance": {
    "maxWidth": 600,
    "padding": 24,
    "gap": 16,
    "radius": 12,
    "background": "#ffffff",
    "mobile": {
      "padding": 16
    }
  },
  "texts": {
    "formTitle": {
      "ja": "楽器買取のお申し込み"
    },
    "formDescription": {
      "ja": "合成データ専用・楽器1点のデモ"
    }
  },
  "fields": [
    {
      "id": "fld_product_family",
      "key": "product_family",
      "type": "choice.select",
      "label": {
        "ja": "商品カテゴリ"
      },
      "classification": "public",
      "persist": "allowed",
      "required": true,
      "options": [
        {
          "value": "gakki_site",
          "label": {
            "ja": "楽器"
          }
        },
        {
          "value": "other",
          "label": {
            "ja": "その他"
          }
        }
      ],
      "config": {
        "presentation": "native",
        "queryParameter": "family"
      }
    },
    {
      "id": "fld_category",
      "key": "category",
      "type": "choice.select",
      "label": {
        "ja": "楽器カテゴリ"
      },
      "classification": "public",
      "persist": "allowed",
      "required": true,
      "options": [
        {
          "value": "guitar-bass",
          "label": {
            "ja": "ギター、ベース"
          }
        },
        {
          "value": "piano",
          "label": {
            "ja": "ピアノ、エレクトーン"
          }
        },
        {
          "value": "keyboard",
          "label": {
            "ja": "キーボード、電子ピアノ"
          }
        },
        {
          "value": "inst",
          "label": {
            "ja": "管楽器・弦楽器・打楽器"
          }
        },
        {
          "value": "dtm-dj",
          "label": {
            "ja": "DTM・DJ・音響機器"
          }
        },
        {
          "value": "gakki-accessories",
          "label": {
            "ja": "周辺機器・アクセサリー"
          }
        },
        {
          "value": "gakki-o",
          "label": {
            "ja": "その他"
          }
        }
      ],
      "config": {
        "presentation": "native"
      },
      "visibleWhen": {
        "op": "eq",
        "args": [
          {
            "ref": "$local:fld_product_family"
          },
          {
            "const": "gakki_site"
          }
        ]
      },
      "clearOnDeactivate": true,
      "resetOnChange": [
        "fld_product_family"
      ]
    },
    {
      "id": "fld_title",
      "key": "title",
      "type": "text",
      "label": {
        "ja": "メーカー、モデル、型番など"
      },
      "classification": "personal",
      "persist": "never",
      "required": true,
      "validators": [
        {
          "use": "maxLength",
          "params": {
            "value": 250
          }
        }
      ],
      "placeholder": {
        "ja": "例）合成楽器 Model A"
      },
      "visibleWhen": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "$local:fld_product_family"
              },
              {
                "const": "other"
              }
            ]
          },
          {
            "op": "isNotEmpty",
            "args": [
              {
                "ref": "$local:fld_category"
              }
            ]
          }
        ]
      },
      "resetOnChange": [
        "fld_product_family",
        "fld_category"
      ],
      "clearOnDeactivate": true
    },
    {
      "id": "fld_condition",
      "key": "condition",
      "type": "choice.radio",
      "label": {
        "ja": "商品の状態"
      },
      "classification": "public",
      "persist": "allowed",
      "required": true,
      "options": [
        {
          "value": "used",
          "label": {
            "ja": "中古"
          }
        },
        {
          "value": "broken",
          "label": {
            "ja": "故障"
          }
        },
        {
          "value": "unused",
          "label": {
            "ja": "未使用"
          }
        }
      ],
      "config": {
        "presentation": "native"
      },
      "visibleWhen": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "$local:fld_product_family"
              },
              {
                "const": "other"
              }
            ]
          },
          {
            "op": "isNotEmpty",
            "args": [
              {
                "ref": "$local:fld_category"
              }
            ]
          }
        ]
      },
      "resetOnChange": [
        "fld_product_family",
        "fld_category"
      ],
      "clearOnDeactivate": true,
      "appearance": {
        "columns": 3,
        "mobile": {
          "columns": 3
        }
      }
    },
    {
      "id": "fld_location",
      "key": "location",
      "type": "choice.select",
      "label": {
        "ja": "建物の何階に設置していますか？"
      },
      "classification": "public",
      "persist": "allowed",
      "required": true,
      "options": [
        {
          "value": "1階",
          "label": {
            "ja": "1階"
          }
        },
        {
          "value": "2～3階",
          "label": {
            "ja": "2～3階"
          }
        },
        {
          "value": "4階以上",
          "label": {
            "ja": "4階以上"
          }
        }
      ],
      "config": {
        "presentation": "native"
      },
      "visibleWhen": {
        "op": "eq",
        "args": [
          {
            "ref": "$local:fld_category"
          },
          {
            "const": "piano"
          }
        ]
      },
      "resetOnChange": [
        "fld_product_family",
        "fld_category"
      ],
      "clearOnDeactivate": true
    },
    {
      "id": "fld_location2",
      "key": "location2",
      "type": "choice.select",
      "label": {
        "ja": "搬出について"
      },
      "classification": "public",
      "persist": "allowed",
      "required": true,
      "options": [
        {
          "value": "エレベーターを使用",
          "label": {
            "ja": "エレベーターを使用"
          }
        },
        {
          "value": "階段作業が必要",
          "label": {
            "ja": "階段作業が必要"
          }
        },
        {
          "value": "クレーン作業が必要",
          "label": {
            "ja": "クレーン作業が必要"
          }
        }
      ],
      "config": {
        "presentation": "native"
      },
      "visibleWhen": {
        "op": "and",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "$local:fld_category"
              },
              {
                "const": "piano"
              }
            ]
          },
          {
            "op": "in",
            "args": [
              {
                "ref": "$local:fld_location"
              },
              {
                "const": [
                  "2～3階",
                  "4階以上"
                ]
              }
            ]
          }
        ]
      },
      "resetOnChange": [
        "fld_product_family",
        "fld_category"
      ],
      "clearOnDeactivate": true
    },
    {
      "id": "fld_item_comment",
      "key": "item_comment",
      "type": "textarea",
      "label": {
        "ja": "補足事項"
      },
      "classification": "personal",
      "persist": "never",
      "required": false,
      "placeholder": {
        "ja": "例）付属品：合成ケース"
      },
      "visibleWhen": {
        "op": "or",
        "args": [
          {
            "op": "eq",
            "args": [
              {
                "ref": "$local:fld_product_family"
              },
              {
                "const": "other"
              }
            ]
          },
          {
            "op": "isNotEmpty",
            "args": [
              {
                "ref": "$local:fld_category"
              }
            ]
          }
        ]
      },
      "resetOnChange": [
        "fld_product_family",
        "fld_category"
      ],
      "clearOnDeactivate": true
    },
    {
      "id": "fld_confirm_title",
      "key": "confirm_title",
      "type": "calculated",
      "label": {
        "ja": "商品名"
      },
      "classification": "personal",
      "persist": "never",
      "submit": "displayOnly",
      "formula": {
        "ref": "$local:fld_title"
      }
    },
    {
      "id": "fld_confirm_category",
      "key": "confirm_category",
      "type": "calculated",
      "label": {
        "ja": "楽器カテゴリ"
      },
      "classification": "public",
      "persist": "never",
      "submit": "displayOnly",
      "formula": {
        "ref": "$local:fld_category"
      }
    },
    {
      "id": "fld_confirm_condition",
      "key": "confirm_condition",
      "type": "calculated",
      "label": {
        "ja": "商品の状態"
      },
      "classification": "public",
      "persist": "never",
      "submit": "displayOnly",
      "formula": {
        "ref": "$local:fld_condition"
      }
    },
    {
      "id": "fld_confirm_item_comment",
      "key": "confirm_item_comment",
      "type": "calculated",
      "label": {
        "ja": "補足事項"
      },
      "classification": "personal",
      "persist": "never",
      "submit": "displayOnly",
      "formula": {
        "ref": "$local:fld_item_comment"
      }
    },
    {
      "id": "fld_kana",
      "key": "kana",
      "type": "katakana",
      "label": {
        "ja": "お名前（カナ）"
      },
      "classification": "personal",
      "persist": "never",
      "required": true,
      "validators": [
        {
          "use": "formatKatakana"
        }
      ]
    },
    {
      "id": "fld_email",
      "key": "email",
      "type": "email",
      "label": {
        "ja": "メールアドレス"
      },
      "classification": "personal",
      "persist": "never",
      "required": true,
      "validators": [
        {
          "use": "formatEmail"
        }
      ]
    },
    {
      "id": "fld_phone_number",
      "key": "phone_number",
      "type": "tel",
      "label": {
        "ja": "電話番号"
      },
      "classification": "personal",
      "persist": "never",
      "required": true,
      "validators": [
        {
          "use": "formatPhoneJP"
        }
      ]
    },
    {
      "id": "fld_agree_policy",
      "key": "agree_policy",
      "type": "boolean",
      "label": {
        "ja": "個人情報保護方針に同意する"
      },
      "classification": "public",
      "persist": "allowed",
      "required": true,
      "config": {
        "presentation": "native"
      },
      "appearance": {
        "columns": 2,
        "gap": 12,
        "mobile": {
          "columns": 2,
          "gap": 12
        }
      },
      "validators": [
        {
          "use": "mustBeTrue"
        }
      ]
    },
    {
      "id": "fld_subscribe_mm",
      "key": "subscribe_mm",
      "type": "boolean",
      "label": {
        "ja": "メールマガジンを受け取る"
      },
      "classification": "public",
      "persist": "allowed",
      "required": false,
      "config": {
        "presentation": "native"
      },
      "appearance": {
        "columns": 2,
        "gap": 12,
        "mobile": {
          "columns": 2,
          "gap": 12
        }
      }
    }
  ],
  "steps": [
    {
      "id": "stp_product",
      "kind": "form",
      "title": {
        "ja": "商品情報を入力"
      },
      "content": [
        {
          "field": "$local:fld_product_family"
        },
        {
          "field": "$local:fld_category"
        },
        {
          "field": "$local:fld_title"
        },
        {
          "field": "$local:fld_condition"
        },
        {
          "field": "$local:fld_location"
        },
        {
          "field": "$local:fld_location2"
        },
        {
          "field": "$local:fld_item_comment"
        }
      ],
      "transitions": [
        {
          "default": "stp_product_confirm"
        }
      ]
    },
    {
      "id": "stp_product_confirm",
      "kind": "form",
      "title": {
        "ja": "商品確認"
      },
      "content": [
        {
          "field": "$local:fld_confirm_title"
        },
        {
          "field": "$local:fld_confirm_category"
        },
        {
          "field": "$local:fld_confirm_condition"
        },
        {
          "field": "$local:fld_confirm_item_comment"
        }
      ],
      "transitions": [
        {
          "default": "stp_customer"
        }
      ]
    },
    {
      "id": "stp_customer",
      "kind": "form",
      "title": {
        "ja": "お客様情報"
      },
      "content": [
        {
          "field": "$local:fld_kana"
        },
        {
          "field": "$local:fld_email"
        },
        {
          "field": "$local:fld_phone_number"
        },
        {
          "field": "$local:fld_agree_policy"
        },
        {
          "field": "$local:fld_subscribe_mm"
        }
      ],
      "transitions": [
        {
          "default": "stp_review"
        }
      ]
    },
    {
      "id": "stp_review",
      "kind": "review",
      "transitions": [
        {
          "default": "stp_complete"
        }
      ]
    },
    {
      "id": "stp_complete",
      "kind": "complete"
    }
  ]
}
