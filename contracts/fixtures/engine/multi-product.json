  "steps": [
    {
      "id": "stp_products",
      "kind": "form",
      "title": {
        "ja": "商品情報を入力"
      },
      "content": [
        {
          "group": "$local:grp_products"
        }
      ],
      "transitions": [
        {
          "default": "stp_customer"
        }
      ]
    },
    {
      "id": "stp_customer",
      "kind": "form",
      "title": {
        "ja": "お客様情報"
      },
      "content": [
        {
          "field": "$local:fld_kana"
        },
        {
          "field": "$local:fld_email"
        },
        {
          "field": "$local:fld_phone_number"
        },
        {
          "field": "$local:fld_agree_policy"
        },
        {
          "field": "$local:fld_subscribe_mm"
        }
      ],
      "transitions": [
        {
          "default": "stp_review"
        }
      ]
    },
    {
      "id": "stp_review",
      "kind": "review",
      "transitions": [
        {
          "default": "stp_complete"
        }
      ]
    },
    {
      "id": "stp_complete",
      "kind": "complete"
    }
