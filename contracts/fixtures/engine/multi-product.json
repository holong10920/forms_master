                          "gakki_site",
                          "sports_outdoor"
                        ]
                      }
                    ]
                  }
                ]
              },
              {
                "op": "isNotEmpty",
                "args": [
                  {
                    "item": "fld_category"
                  }
                ]
              }
            ]
          },
          "resetOnChange": [
            "fld_product_family",
            "fld_category"
          ],
          "clearOnDeactivate": true
        }
      ]
    },
