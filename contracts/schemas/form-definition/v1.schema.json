{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "formId": {
      "type": "string"
    },
    "siteId": {
      "type": "string"
    },
    "kind": {
      "const": "form"
    },
    "locale": {
      "type": "object",
      "properties": {
        "default": {
          "const": "ja"
        },
        "supported": {
          "type": "array",
          "items": {
            "const": "ja"
          }
        }
      },
      "required": ["default", "supported"],
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 1000
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "maxItems": 200
    },
    "conditions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Condition"
      }
    }
  },
  "required": ["schemaVersion", "kind", "formId", "siteId", "fields", "steps"],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.forms-poc.invalid/form-definition/v1.schema.json",
  "title": "FormDefinitionV1",
  "$defs": {
    "Expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "required": ["ref"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "item": {
              "type": "string"
            }
          },
          "required": ["item"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "const": {
              "oneOf": [
                {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "required": ["const"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cond": {
              "type": "string"
            }
          },
          "required": ["cond"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "and",
                "or",
                "not",
                "eq",
                "neq",
                "in",
                "notIn",
                "lt",
                "lte",
                "gt",
                "gte",
                "isEmpty",
                "isNotEmpty",
                "includes",
                "includesAny",
                "any",
                "all",
                "count",
                "sum",
                "add",
                "subtract",
                "multiply",
                "min",
                "max",
                "concat",
                "choose"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              }
            }
          },
          "required": ["op", "args"],
          "additionalProperties": false
        }
      ]
    },
    "Field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "boolean",
            "choice.radio",
            "choice.select",
            "choice.checkboxes",
            "calculated",
            "email",
            "tel",
            "postal",
            "katakana"
          ]
        },
        "label": {
          "type": "object",
          "properties": {
            "ja": {
              "type": "string"
            }
          },
          "required": ["ja"],
          "additionalProperties": false
        },
        "classification": {
          "enum": ["public", "personal", "secret"]
        },
        "persist": {
          "enum": ["allowed", "never"]
        },
        "submit": {
          "enum": ["include", "displayOnly"]
        },
        "required": {
          "type": "boolean"
        },
        "clearOnDeactivate": {
          "type": "boolean"
        },
        "visibleWhen": {
          "$ref": "#/$defs/Expression"
        },
        "requiredWhen": {
          "$ref": "#/$defs/Expression"
        },
        "formula": {
          "$ref": "#/$defs/Expression"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "object",
                "properties": {
                  "ja": {
                    "type": "string"
                  }
                },
                "required": ["ja"],
                "additionalProperties": false
              },
              "exclusive": {
                "type": "boolean"
              },
              "availableWhen": {
                "$ref": "#/$defs/Expression"
              }
            },
            "required": ["value"],
            "additionalProperties": false
          }
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "use": {
                "enum": [
                  "required",
                  "minLength",
                  "maxLength",
                  "min",
                  "max",
                  "minItems",
                  "maxItems",
                  "exclusiveOption",
                  "mustBeTrue"
                ]
              },
              "params": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer"
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": ["use"],
            "additionalProperties": false
          }
        }
      },
      "required": ["id", "key", "type", "classification"],
      "additionalProperties": false
    },
    "Transition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/Expression"
            },
            "to": {
              "type": "string"
            }
          },
          "required": ["when", "to"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "string"
            }
          },
          "required": ["default"],
          "additionalProperties": false
        }
      ]
    },
    "Step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": ["form", "review", "complete"]
        },
        "title": {
          "type": "object",
          "properties": {
            "ja": {
              "type": "string"
            }
          },
          "required": ["ja"],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  }
                },
                "required": ["field"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "group": {
                    "type": "string"
                  }
                },
                "required": ["group"],
                "additionalProperties": false
              }
            ]
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transition"
          }
        },
        "skipWhen": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": ["id", "kind"],
      "additionalProperties": false
    },
    "Condition": {
      "type": "object",
      "properties": {
        "label": {
          "type": "object",
          "properties": {
            "ja": {
              "type": "string"
            }
          },
          "required": ["ja"],
          "additionalProperties": false
        },
        "when": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": ["label", "when"],
      "additionalProperties": false
    },
    "Group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "type": {
          "const": "group"
        },
        "label": {
          "type": "object",
          "properties": {
            "ja": {
              "type": "string"
            }
          },
          "required": ["ja"],
          "additionalProperties": false
        },
        "classification": {
          "enum": ["public", "personal", "secret"]
        },
        "persist": {
          "enum": ["allowed", "never"]
        },
        "submit": {
          "enum": ["include", "displayOnly"]
        },
        "clearOnDeactivate": {
          "type": "boolean"
        },
        "visibleWhen": {
          "$ref": "#/$defs/Expression"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Field"
          }
        }
      },
      "required": ["id", "key", "type", "classification", "fields"],
      "additionalProperties": false
    },
    "Node": {
      "oneOf": [
        {
          "$ref": "#/$defs/Field"
        },
        {
          "$ref": "#/$defs/Group"
        }
      ]
    }
  }
}
