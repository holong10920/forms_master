{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "formId": {
      "type": "string"
    },
    "siteId": {
      "type": "string"
    },
    "kind": {
      "const": "form"
    },
    "locale": {
      "type": "object",
      "properties": {
        "default": {
          "const": "ja"
        },
        "supported": {
          "type": "array",
          "items": {
            "enum": ["ja", "vi"]
          },
          "minItems": 1,
          "maxItems": 2
        }
      },
      "required": ["default", "supported"],
      "additionalProperties": false
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Node"
      },
      "maxItems": 1000
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "maxItems": 200
    },
    "conditions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Condition"
      }
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "object",
          "properties": {
            "storeSel": {
              "type": "object",
              "properties": {
                "plugin": {
                  "const": "@platform/store-selector"
                },
                "version": {
                  "const": "1.0.0"
                },
                "capability": {
                  "const": "storeSelector"
                },
                "kind": {
                  "const": "fieldType"
                }
              },
              "required": ["plugin", "version", "capability", "kind"],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "blocks": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "object",
          "properties": {
            "id": {
              "enum": ["none", "subtle", "guided"]
            },
            "package": {
              "const": "@platform/motion-presets"
            },
            "version": {
              "const": "1.0.0"
            }
          },
          "required": ["id", "package", "version"],
          "additionalProperties": false
        },
        "categories": {
          "type": "object",
          "properties": {
            "stepTransition": {
              "enum": ["on", "off"]
            },
            "conditionalReveal": {
              "enum": ["on", "off"]
            },
            "validationFeedback": {
              "enum": ["on", "off"]
            },
            "submitFeedback": {
              "enum": ["on", "off"]
            }
          },
          "additionalProperties": false
        },
        "speed": {
          "enum": ["slow", "standard", "fast"]
        }
      },
      "required": ["preset"],
      "additionalProperties": false
    },
    "blockInstances": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "block": {
            "type": "string"
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "integer"
                }
              ]
            }
          }
        },
        "required": ["id", "alias", "block"],
        "additionalProperties": false
      }
    },
    "themeRef": {
      "enum": ["theme_sports@1", "theme_sports_contrast@1", "theme_pc@1", "theme_pc_contrast@1"]
    },
    "texts": {
      "type": "object",
      "properties": {
        "formTitle": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "formDescription": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "next": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "back": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "submit": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "selectPrompt": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "reviewTitle": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "payloadTitle": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "errorSummary": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "completeTitle": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "completeBody": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "invalidNumber": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "required": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "mustBeTrue": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "minLength": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "maxLength": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "min": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "max": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "minItems": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "maxItems": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "exclusiveOption": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "syntheticNotice": {
          "$ref": "#/$defs/LocalizedOverride"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schemaVersion", "kind", "formId", "siteId", "fields", "steps"],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.forms-poc.invalid/form-definition/v1.schema.json",
  "title": "FormDefinitionV1",
  "$defs": {
    "Expression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string"
            }
          },
          "required": ["ref"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "item": {
              "type": "string"
            }
          },
          "required": ["item"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "const": {
              "oneOf": [
                {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            }
          },
          "required": ["const"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cond": {
              "type": "string"
            }
          },
          "required": ["cond"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "and",
                "or",
                "not",
                "eq",
                "neq",
                "in",
                "notIn",
                "lt",
                "lte",
                "gt",
                "gte",
                "isEmpty",
                "isNotEmpty",
                "includes",
                "includesAny",
                "any",
                "all",
                "count",
                "sum",
                "add",
                "subtract",
                "multiply",
                "min",
                "max",
                "concat",
                "choose"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Expression"
              }
            }
          },
          "required": ["op", "args"],
          "additionalProperties": false
        }
      ]
    },
    "Field": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "boolean",
            "choice.radio",
            "choice.select",
            "choice.checkboxes",
            "calculated",
            "email",
            "tel",
            "postal",
            "katakana",
            "plugin:storeSel"
          ]
        },
        "label": {
          "type": "object",
          "properties": {
            "ja": {
              "type": "string"
            },
            "vi": {
              "type": "string"
            }
          },
          "required": ["ja"],
          "additionalProperties": false
        },
        "classification": {
          "enum": ["public", "personal", "secret"]
        },
        "persist": {
          "enum": ["allowed", "never"]
        },
        "submit": {
          "enum": ["include", "displayOnly"]
        },
        "required": {
          "type": "boolean"
        },
        "clearOnDeactivate": {
          "type": "boolean"
        },
        "visibleWhen": {
          "$ref": "#/$defs/Expression"
        },
        "requiredWhen": {
          "$ref": "#/$defs/Expression"
        },
        "formula": {
          "$ref": "#/$defs/Expression"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "label": {
                "type": "object",
                "properties": {
                  "ja": {
                    "type": "string"
                  },
                  "vi": {
                    "type": "string"
                  }
                },
                "required": ["ja"],
                "additionalProperties": false
              },
              "exclusive": {
                "type": "boolean"
              },
              "availableWhen": {
                "$ref": "#/$defs/Expression"
              }
            },
            "required": ["value"],
            "additionalProperties": false
          }
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "use": {
                "enum": [
                  "required",
                  "minLength",
                  "maxLength",
                  "min",
                  "max",
                  "minItems",
                  "maxItems",
                  "exclusiveOption",
                  "mustBeTrue"
                ]
              },
              "params": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer"
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": ["use"],
            "additionalProperties": false
          }
        },
        "config": {
          "type": "object",
          "properties": {
            "filterByPrefecture": {
              "type": "boolean"
            },
            "placeholder": {
              "type": "string",
              "maxLength": 40
            }
          },
          "additionalProperties": false
        },
        "placeholder": {
          "$ref": "#/$defs/LocalizedOverride"
        },
        "help": {
          "$ref": "#/$defs/LocalizedOverride"
        }
      },
      "required": ["id", "key", "type", "classification"],
      "additionalProperties": false
    },
    "Transition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "when": {
              "$ref": "#/$defs/Expression"
            },
            "to": {
              "type": "string"
            }
          },
          "required": ["when", "to"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "type": "string"
            }
          },
          "required": ["default"],
          "additionalProperties": false
        }
      ]
    },
    "Step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": ["form", "review", "complete"]
        },
        "title": {
          "type": "object",
          "properties": {
            "ja": {
              "type": "string"
            },
            "vi": {
              "type": "string"
            }
          },
          "required": ["ja"],
          "additionalProperties": false
        },
        "content": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string"
                  }
                },
                "required": ["field"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "group": {
                    "type": "string"
                  }
                },
                "required": ["group"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "block": {
                    "type": "string"
                  }
                },
                "required": ["block"],
                "additionalProperties": false
              }
            ]
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Transition"
          }
        },
        "skipWhen": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": ["id", "kind"],
      "additionalProperties": false
    },
    "Condition": {
      "type": "object",
      "properties": {
        "label": {
          "type": "object",
          "properties": {
            "ja": {
              "type": "string"
            },
            "vi": {
              "type": "string"
            }
          },
          "required": ["ja"],
          "additionalProperties": false
        },
        "when": {
          "$ref": "#/$defs/Expression"
        }
      },
      "required": ["label", "when"],
      "additionalProperties": false
    },
    "Group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "type": {
          "const": "group"
        },
        "label": {
          "type": "object",
          "properties": {
            "ja": {
              "type": "string"
            },
            "vi": {
              "type": "string"
            }
          },
          "required": ["ja"],
          "additionalProperties": false
        },
        "classification": {
          "enum": ["public", "personal", "secret"]
        },
        "persist": {
          "enum": ["allowed", "never"]
        },
        "submit": {
          "enum": ["include", "displayOnly"]
        },
        "clearOnDeactivate": {
          "type": "boolean"
        },
        "visibleWhen": {
          "$ref": "#/$defs/Expression"
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Field"
          }
        }
      },
      "required": ["id", "key", "type", "classification", "fields"],
      "additionalProperties": false
    },
    "Node": {
      "oneOf": [
        {
          "$ref": "#/$defs/Field"
        },
        {
          "$ref": "#/$defs/Group"
        }
      ]
    },
    "LocalizedOverride": {
      "type": "object",
      "properties": {
        "ja": {
          "type": "string",
          "maxLength": 2000
        },
        "vi": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    }
  }
}
