{
  "name": "forms-master",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "volta": {
    "node": "24.22.1"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "py:lint": "uv run ruff check python tools/engine-demo && uv run ruff format --check python tools/engine-demo",
    "py:typecheck": "uv run mypy",
    "py:test": "uv run pytest",
    "gen": "pnpm --filter @fb/contracts gen",
    "gen:check": "pnpm --filter @fb/contracts gen:check",
    "schemas:lint": "pnpm --filter @fb/contracts lint:schemas",
    "boundaries": "depcruise packages tools --config .dependency-cruiser.cjs --output-type err",
    "py:imports": "uv run lint-imports",
    "secrets": "node tools/security/src/secrets.ts",
    "synthetic:check": "node tools/security/src/synthetic-data-check.ts contracts/fixtures",
    "secrets:gitleaks": "sh tools/security/gitleaks.sh",
    "preflight": "node tools/verify/src/preflight.ts",
    "verify": "pnpm preflight && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm gen:check && pnpm schemas:lint && pnpm boundaries && pnpm py:lint && pnpm py:typecheck && pnpm py:imports && pnpm py:test && pnpm synthetic:check && pnpm secrets",
    "engine:demo": "node tools/engine-demo/src/cli.ts",
    "engine:parity": "node tools/engine-demo/src/parity.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
